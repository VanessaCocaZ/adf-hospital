	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_dim_servicio_cargo')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Billing",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_Dim_Servicio_Cargo",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          tipo_cargo as string,",
						"          estado_pago as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT DISTINCT LTRIM(RTRIM(charge_type)) AS tipo_cargo, COALESCE(NULLIF(LTRIM(RTRIM(payment_status)), \\'\\'), \\'No especificado\\') AS estado_pago FROM silver.billing WHERE charge_type IS NOT NULL AND LTRIM(RTRIM(charge_type)) <> \\'\\'',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          servicio_cargo_key as integer,",
						"          tipo_cargo as string,",
						"          estado_pago as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          tipo_cargo,",
						"          estado_pago",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_fact_admisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_Fact_Admisiones",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT a.admission_id AS admission_id_bk, p.paciente_key, dep.departamento_key, dg.diagnostico_key, CONVERT(INT, CONVERT(CHAR(8), a.admission_date, 112)) AS fecha_ingreso_key, CASE WHEN a.discharge_date IS NULL THEN NULL ELSE CONVERT(INT, CONVERT(CHAR(8), a.discharge_date, 112)) END AS fecha_alta_key, a.attending_doctor_id AS medico_id, CASE WHEN a.discharge_date IS NULL THEN NULL ELSE DATEDIFF(DAY, a.admission_date, a.discharge_date) END AS dias_estancia, 1 AS conteo_admisiones FROM silver.admissions a INNER JOIN gold.dim_paciente p ON p.patient_id_bk = a.patient_id INNER JOIN gold.dim_departamento dep ON dep.nombre_departamento = LTRIM(RTRIM(a.department)) CROSS APPLY (SELECT TOP (1) LTRIM(RTRIM(d.icd_code)) AS codigo_icd, NULLIF(LTRIM(RTRIM(d.diagnosis_description)), \\'\\') AS descripcion_patologia, COALESCE(NULLIF(LTRIM(RTRIM(d.severity)), \\'\\'), \\'No especificado\\') AS nivel_severidad FROM silver.diagnoses d WHERE d.admission_id = a.admission_id ORDER BY d.diagnosis_id) d1 INNER JOIN gold.dim_diagnostico dg ON dg.codigo_icd = d1.codigo_icd AND (dg.descripcion_patologia = d1.descripcion_patologia OR (dg.descripcion_patologia IS NULL AND d1.descripcion_patologia IS NULL)) AND dg.nivel_severidad = d1.nivel_severidad INNER JOIN gold.dim_fecha fi ON fi.fecha_key = CONVERT(INT, CONVERT(CHAR(8), a.admission_date, 112)) LEFT JOIN gold.dim_fecha fa ON fa.fecha_key = CONVERT(INT, CONVERT(CHAR(8), a.discharge_date, 112)) WHERE a.discharge_date IS NULL OR fa.fecha_key IS NOT NULL',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admision_key as long,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          diagnostico_key as integer,",
						"          fecha_ingreso_key as integer,",
						"          fecha_alta_key as integer,",
						"          medico_id as integer,",
						"          dias_estancia as integer,",
						"          conteo_admisiones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          admission_id_bk,",
						"          paciente_key,",
						"          departamento_key,",
						"          diagnostico_key,",
						"          fecha_ingreso_key,",
						"          fecha_alta_key,",
						"          medico_id,",
						"          dias_estancia,",
						"          conteo_admisiones",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_fact_facturacion')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "Gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Billing",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Gold_Fact_Facturacion",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [],
					"scriptLines": [
						"source(output(",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          servicio_cargo_key as integer,",
						"          fecha_pago_key as integer,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     query: 'SELECT b.billing_id AS billing_id_bk, b.admission_id AS admission_id_bk, p.paciente_key, dep.departamento_key, sc.servicio_cargo_key, f.fecha_key AS fecha_pago_key, CAST(b.amount AS DECIMAL(12,2)) AS monto_facturado, 1 AS conteo_transacciones FROM silver.billing b INNER JOIN silver.admissions a ON a.admission_id = b.admission_id INNER JOIN gold.dim_paciente p ON p.patient_id_bk = a.patient_id INNER JOIN gold.dim_departamento dep ON dep.nombre_departamento = LTRIM(RTRIM(a.department)) INNER JOIN gold.dim_servicio_cargo sc ON sc.tipo_cargo = LTRIM(RTRIM(b.charge_type)) AND sc.estado_pago = COALESCE(NULLIF(LTRIM(RTRIM(b.payment_status)), \\'\\'), \\'No especificado\\') LEFT JOIN gold.dim_fecha f ON f.fecha_key = CONVERT(INT, CONVERT(CHAR(8), b.payment_date, 112)) WHERE b.payment_date IS NULL OR f.fecha_key IS NOT NULL',",
						"     format: 'query') ~> source1",
						"source1 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          facturacion_key as long,",
						"          billing_id_bk as integer,",
						"          admission_id_bk as integer,",
						"          paciente_key as integer,",
						"          departamento_key as integer,",
						"          servicio_cargo_key as integer,",
						"          fecha_pago_key as integer,",
						"          monto_facturado as decimal(12,2),",
						"          conteo_transacciones as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          billing_id_bk,",
						"          admission_id_bk,",
						"          paciente_key,",
						"          departamento_key,",
						"          servicio_cargo_key,",
						"          fecha_pago_key,",
						"          monto_facturado,",
						"          conteo_transacciones",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_admissions')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "Silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Admissions",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "DS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "sourcePatients"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "selectPatients"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "filterValidos"
						},
						{
							"name": "derivedColumn4"
						},
						{
							"name": "filterFechas"
						},
						{
							"name": "existsPatients"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as string,",
						"          patient_id as string,",
						"          admission_date as string,",
						"          discharge_date as string,",
						"          department as string,",
						"          attending_doctor_id as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source(output(",
						"          patient_id as integer",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> sourcePatients",
						"sourcePatients select(mapColumn(",
						"          patient_id_ref = patient_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectPatients",
						"source1 derive(admission_id = trim(admission_id),",
						"          patient_id = trim(patient_id),",
						"          admission_date = trim(admission_date),",
						"          discharge_date = trim(discharge_date),",
						"          department = trim(department),",
						"          attending_doctor_id = trim(attending_doctor_id)) ~> derivedColumn1",
						"derivedColumn1 derive(department = iif(regexMatch(lower(trim(department)), '^(cardiology|cardiolgy|cardio)$'), 'Cardiology', iif(regexMatch(lower(trim(department)), '^(oncology|oncologyy|onco)$'), 'Oncology', iif(regexMatch(lower(trim(department)), '^(emergency|emergancy|er)$'), 'Emergency', iif(regexMatch(lower(trim(department)), '^(general surgery|generalsurgery|gen surg)$'), 'General Surgery', iif(regexMatch(lower(trim(department)), '^(pediatrics|paediatrics|peds)$'), 'Pediatrics', iif(regexMatch(lower(trim(department)), '^(neurology|nuerology|neuro)$'), 'Neurology', iif(regexMatch(lower(trim(department)), '^(orthopedics|orthopaedics|ortho)$'), 'Orthopedics', trim(department))))))))) ~> derivedColumn2",
						"derivedColumn2 filter(!isNull(admission_id) && isInteger(admission_id) &&",
						" !isNull(patient_id) && isInteger(patient_id) &&",
						" !isNull(attending_doctor_id) && isInteger(attending_doctor_id) &&",
						" !isNull(admission_date) && admission_date != '' &&",
						" !isNull(department) && department != '') ~> filterValidos",
						"filterValidos derive(admission_id = toInteger(admission_id),",
						"          patient_id = toInteger(patient_id),",
						"          attending_doctor_id = toInteger(attending_doctor_id),",
						"          admission_date = iif(regexMatch(trim(admission_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(admission_date), 'yyyy-MM-dd'), iif(regexMatch(trim(admission_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(admission_date), 'MM/dd/yyyy'), iif(regexMatch(trim(admission_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(admission_date), 'dd-MMM-yyyy'), iif(regexMatch(trim(admission_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'), toDate(trim(admission_date), 'MMMM d, yyyy'), iif(regexMatch(trim(admission_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(iif(toInteger(substring(trim(admission_date), 7, 2)) <= 26, '20', '19'), substring(trim(admission_date), 7, 2), '-', substring(trim(admission_date), 1, 2), '-', substring(trim(admission_date), 4, 2)), 'yyyy-MM-dd'), toDate(null())))))),",
						"          discharge_date = iif(regexMatch(trim(discharge_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(trim(discharge_date), 'yyyy-MM-dd'), iif(regexMatch(trim(discharge_date), '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(trim(discharge_date), 'MM/dd/yyyy'), iif(regexMatch(trim(discharge_date), '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(trim(discharge_date), 'dd-MMM-yyyy'), iif(regexMatch(trim(discharge_date), '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'), toDate(trim(discharge_date), 'MMMM d, yyyy'), iif(regexMatch(trim(discharge_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(iif(toInteger(substring(trim(discharge_date), 7, 2)) <= 26, '20', '19'), substring(trim(discharge_date), 7, 2), '-', substring(trim(discharge_date), 1, 2), '-', substring(trim(discharge_date), 4, 2)), 'yyyy-MM-dd'), toDate(null()))))))) ~> derivedColumn4",
						"derivedColumn4 filter(!isNull(admission_date)) ~> filterFechas",
						"filterFechas, selectPatients exists(patient_id == patient_id_ref,",
						"     negate:false,",
						"     broadcast: 'auto')~> existsPatients",
						"existsPatients sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          admission_id,",
						"          patient_id,",
						"          admission_date,",
						"          discharge_date,",
						"          department,",
						"          attending_doctor_id",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_billing')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "Silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Billing",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "sourceAdmissions"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Billing",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "selectAdmissions"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "filterValidos"
						},
						{
							"name": "derivedColumn4"
						},
						{
							"name": "existsAdmissions"
						}
					],
					"scriptLines": [
						"source(output(",
						"          billing_id as string,",
						"          admission_id as string,",
						"          charge_type as string,",
						"          amount as string,",
						"          payment_status as string,",
						"          payment_date as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source(output(",
						"          admission_id as integer",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> sourceAdmissions",
						"sourceAdmissions select(mapColumn(",
						"          admission_id_ref = admission_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectAdmissions",
						"source1 derive(billing_id = trim(billing_id),",
						"          admission_id = trim(admission_id),",
						"          charge_type = trim(charge_type),",
						"          amount = trim(amount),",
						"          payment_status = trim(payment_status),",
						"          payment_date = trim(payment_date)) ~> derivedColumn1",
						"derivedColumn1 derive(charge_type = iif(isNull(charge_type) || charge_type == '', toString(null()), iif(lower(charge_type) == 'lab test', 'Lab Test', iif(lower(charge_type) == 'consultation', 'Consultation', iif(lower(charge_type) == 'medication', 'Medication', iif(lower(charge_type) == 'imaging', 'Imaging', iif(lower(charge_type) == 'surgery', 'Surgery', iif(lower(charge_type) == 'room', 'Room', charge_type))))))),",
						"          payment_status = iif(lower(payment_status) == 'paid', 'Paid', iif(lower(payment_status) == 'unpaid', 'Unpaid', iif(lower(payment_status) == 'pending', 'Pending', iif(lower(payment_status) == 'overdue', 'Overdue', payment_status)))),",
						"          amount = regexReplace(regexReplace(amount, 'USD', ''), '[,$ ]', '')) ~> derivedColumn2",
						"derivedColumn2 filter(!isNull(billing_id) && isInteger(billing_id) &&",
						"     !isNull(admission_id) && isInteger(admission_id) &&",
						"     !isNull(charge_type) && charge_type != '' &&",
						"     !isNull(amount) && isDecimal(amount) &&",
						"     !isNull(payment_status) && payment_status != '') ~> filterValidos",
						"filterValidos derive(billing_id = toInteger(billing_id),",
						"          admission_id = toInteger(admission_id),",
						"          amount = toDecimal(amount, 12, 2),",
						"          payment_date = iif(regexMatch(payment_date, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(payment_date, 'yyyy-MM-dd'), iif(regexMatch(payment_date, '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(payment_date, 'MM/dd/yyyy'), iif(regexMatch(payment_date, '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(payment_date, 'dd-MMM-yyyy'), iif(regexMatch(payment_date, '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'), toDate(payment_date, 'MMMM d, yyyy'), iif(regexMatch(payment_date, '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(iif(toInteger(substring(payment_date, 7, 2)) <= 26, '20', '19'), substring(payment_date, 7, 2), '-', substring(payment_date, 1, 2), '-', substring(payment_date, 4, 2)), 'yyyy-MM-dd'), toDate(null()))))))) ~> derivedColumn4",
						"derivedColumn4, selectAdmissions exists(admission_id == admission_id_ref,",
						"     negate:false,",
