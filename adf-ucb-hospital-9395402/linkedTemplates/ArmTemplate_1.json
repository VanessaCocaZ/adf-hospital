		{
			"name": "[concat(parameters('factoryName'), '/df_silver_diagnoses')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "Silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Diagnoses",
								"type": "DatasetReference"
							},
							"name": "source1"
						},
						{
							"dataset": {
								"referenceName": "DS_Silver_Admissions",
								"type": "DatasetReference"
							},
							"name": "sourceAdmissions"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Diagnoses",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "selectAdmissions"
						},
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "filterValidos"
						},
						{
							"name": "derivedColumn4"
						},
						{
							"name": "existsAdmissions"
						}
					],
					"scriptLines": [
						"source(output(",
						"          diagnosis_id as string,",
						"          admission_id as string,",
						"          icd_code as string,",
						"          diagnosis_description as string,",
						"          severity as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source(output(",
						"          admission_id as integer",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> sourceAdmissions",
						"sourceAdmissions select(mapColumn(",
						"          admission_id_ref = admission_id",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> selectAdmissions",
						"source1 derive(diagnosis_id = trim(diagnosis_id),",
						"          admission_id = trim(admission_id),",
						"          icd_code = trim(icd_code),",
						"          diagnosis_description = trim(diagnosis_description),",
						"          severity = trim(severity)) ~> derivedColumn1",
						"derivedColumn1 derive(icd_code = regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(regexReplace(upper(regexReplace(icd_code, ' *, *', ', ')), 'F32-9|F329', 'F32.9'), 'M54-5|M545', 'M54.5'), 'E11-9|E119', 'E11.9'), 'N39-0|N390', 'N39.0'), 'K21-9|K219', 'K21.9'), 'J45-909|J45909', 'J45.909'), 'C50-911|C50911', 'C50.911'), 'S72-001A|S72001A', 'S72.001A'), 'I-10|I10', 'I10'), 'R-51', 'R51'),",
						"          severity = iif(isNull(severity) || severity == '', toString(null()), iif(lower(severity) == 'mild', 'Mild', iif(lower(severity) == 'moderate', 'Moderate', iif(lower(severity) == 'severe', 'Severe', iif(lower(severity) == 'critical', 'Critical', severity))))),",
						"          diagnosis_description = iif(isNull(diagnosis_description) || diagnosis_description == '', toString(null()), diagnosis_description)) ~> derivedColumn2",
						"derivedColumn2 filter(!isNull(diagnosis_id) && isInteger(diagnosis_id) &&",
						" !isNull(admission_id) && isInteger(admission_id) &&",
						" !isNull(icd_code) && icd_code != '') ~> filterValidos",
						"filterValidos derive(diagnosis_id = toInteger(diagnosis_id),",
						"          admission_id = toInteger(admission_id)) ~> derivedColumn4",
						"derivedColumn4, selectAdmissions exists(admission_id == admission_id_ref,",
						"     negate:false,",
						"     broadcast: 'auto')~> existsAdmissions",
						"existsAdmissions sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          diagnosis_id as integer,",
						"          admission_id as integer,",
						"          icd_code as string,",
						"          diagnosis_description as string,",
						"          severity as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          diagnosis_id,",
						"          admission_id,",
						"          icd_code,",
						"          diagnosis_description,",
						"          severity",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_silver_patients')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "Silver"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "DS_Bronze_Patients",
								"type": "DatasetReference"
							},
							"name": "source1"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "DS_Silver_Patients",
								"type": "DatasetReference"
							},
							"name": "sink1"
						}
					],
					"transformations": [
						{
							"name": "derivedColumn1"
						},
						{
							"name": "derivedColumn2"
						},
						{
							"name": "filterValidos"
						},
						{
							"name": "derivedColumn4"
						}
					],
					"scriptLines": [
						"source(output(",
						"          patient_id as string,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as string,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     allowSchemaDrift: false,",
						"     validateSchema: true,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> source1",
						"source1 derive(patient_id = trim(patient_id),",
						"          full_name = trim(full_name),",
						"          gender = trim(gender),",
						"          date_of_birth = trim(date_of_birth),",
						"          phone = trim(phone),",
						"          email = trim(email),",
						"          address = trim(address),",
						"          insurance_provider = trim(insurance_provider)) ~> derivedColumn1",
						"derivedColumn1 derive(gender = iif(\r",
						"    isNull(gender) || gender == '',\r",
						"    toString(null()),\r",
						"    iif(\r",
						"        lower(gender) == 'm' || lower(gender) == 'male',\r",
						"        'Male',\r",
						"        iif(\r",
						"            lower(gender) == 'f' || lower(gender) == 'female',\r",
						"            'Female',\r",
						"            'Unknown'\r",
						"        )\r",
						"    )\r",
						"),",
						"          phone = iif(\r",
						"    isNull(phone) || trim(phone) == '' || lower(trim(phone)) == 'unknown',\r",
						"    toString(null()),\r",
						"    iif(\r",
						"        startsWith(regexReplace(trim(phone), '[^0-9+]', ''), '+1')\r",
						"        && length(regexReplace(trim(phone), '[^0-9+]', '')) == 12,\r",
						"        right(regexReplace(trim(phone), '[^0-9]', ''), 10),\r",
						"        iif(\r",
						"            length(regexReplace(trim(phone), '[^0-9]', '')) == 10,\r",
						"            regexReplace(trim(phone), '[^0-9]', ''),\r",
						"            toString(null())\r",
						"        )\r",
						"    )\r",
						"),",
						"          email = iif(isNull(email) || email == '', toString(null()), lower(email)),",
						"          insurance_provider = iif(\r",
						"    isNull(insurance_provider) || insurance_provider == '',\r",
						"    toString(null()),\r",
						"    iif(\r",
						"        lower(insurance_provider) == 'cigna' ||\r",
						"        lower(insurance_provider) == 'cigna health',\r",
						"        'Cigna',\r",
						"        iif(\r",
						"            lower(insurance_provider) == 'aetna' ||\r",
						"            lower(insurance_provider) == 'aetnaa' ||\r",
						"            lower(insurance_provider) == 'aetna inc.',\r",
						"            'Aetna',\r",
						"            iif(\r",
						"                lower(insurance_provider) == 'bluecross' ||\r",
						"                lower(insurance_provider) == 'blue cross' ||\r",
						"                lower(insurance_provider) == 'blue-cross',\r",
						"                'Blue Cross',\r",
						"                iif(\r",
						"                    lower(insurance_provider) == 'medicare' ||\r",
						"                    lower(insurance_provider) == 'medi-care',\r",
						"                    'Medicare',\r",
						"                    iif(\r",
						"                        lower(insurance_provider) == 'medicaid',\r",
						"                        'Medicaid',\r",
						"                        insurance_provider\r",
						"                    )\r",
						"                )\r",
						"            )\r",
						"        )\r",
						"    )\r",
						")) ~> derivedColumn2",
						"derivedColumn2 filter(!isNull(patient_id) && isInteger(patient_id) && !isNull(full_name) && full_name != '') ~> filterValidos",
						"filterValidos derive(patient_id = toInteger(patient_id),",
						"          date_of_birth = case(",
						"          isNull(date_of_birth) || date_of_birth == '', toDate(null()),",
						"          regexMatch(date_of_birth, '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'), toDate(date_of_birth, 'yyyy-MM-dd'),",
						"          regexMatch(date_of_birth, '^[0-9]{2}/[0-9]{2}/[0-9]{4}$'), toDate(date_of_birth, 'MM/dd/yyyy'),",
						"          regexMatch(date_of_birth, '^[0-9]{2}-[A-Za-z]{3}-[0-9]{4}$'), toDate(date_of_birth, 'dd-MMM-yyyy'),",
						"          regexMatch(date_of_birth, '^[A-Za-z]+ [0-9]{1,2}, [0-9]{4}$'), toDate(date_of_birth, 'MMMM d, yyyy'),",
						"          regexMatch(date_of_birth, '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'), toDate(concat(iif(toInteger(substring(date_of_birth, 7, 2)) <= 26, '20', '19'), substring(date_of_birth, 7, 2), '-', substring(date_of_birth, 1, 2), '-', substring(date_of_birth, 4, 2)), 'yyyy-MM-dd'),",
						"          toDate(null())",
						"     )) ~> derivedColumn4",
						"derivedColumn4 sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     input(",
						"          patient_id as integer,",
						"          full_name as string,",
						"          gender as string,",
						"          date_of_birth as date,",
						"          phone as string,",
						"          email as string,",
						"          address as string,",
						"          insurance_provider as string",
						"     ),",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError',",
						"     mapColumn(",
						"          patient_id,",
						"          full_name,",
						"          gender,",
						"          date_of_birth,",
						"          phone,",
						"          email,",
						"          address,",
						"          insurance_provider",
						"     )) ~> sink1"
					]
				}
			},
			"dependsOn": []
		},
